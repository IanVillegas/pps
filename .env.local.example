# DEC-001B: las variables de abajo son las unicas que el codigo realmente
# lee (verificado con grep). El .env.local.example anterior documentaba
# variables de otro microfrontend (pagos, efectivo, comprobantes) que no
# existen en ninguna parte de este proyecto.

# Nombre del entorno (DEV/CERT/...). Usado en next.config.js para decidir si
# se eliminan los console.log en build (se quitan salvo en DEV/CERT).
NEXT_PUBLIC_ENVIRONMENT=

# Base URL del cliente HTTP de sad-aml-shared (src/sad-aml-shared/services/api/AxiosClient.ts).
# Alcance actual: frontend con datos simulados (ver AGENTS.md); no hay
# adaptador real conectado todavia, esta variable no se usa activamente hasta
# que exista un contrato de API.
NEXT_PUBLIC_API_BASE_URL=
